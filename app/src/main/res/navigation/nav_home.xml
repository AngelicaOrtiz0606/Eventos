<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_home"
    app:startDestination="@id/eventosFragment">

    <fragment
        android:id="@+id/eventosFragment"
        android:name="com.example.eventos.home.eventos.EventosFragment"
        android:label="fragment_eventos"
        tools:layout="@layout/fragment_evento">
        <action
            android:id="@+id/action_eventosFragment_to_eventoDetailFragment"
            app:destination="@id/eventoDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/accountFragment"
        android:name="com.example.eventos.home.account.accountFragment"
        android:label="fragment_account"
        tools:layout="@layout/fragment_account" />

    <fragment
        android:id="@+id/myEventosFragment"
        android:name="com.example.eventos.home.eventos.MyEventosFragment"
        android:label="Mis Eventos"
        tools:layout="@layout/fragment_my_eventos">
        <action
            android:id="@+id/action_myEventosFragment_to_eventoDetailFragment"
            app:destination="@id/eventoDetailFragment" />
    </fragment>

    <fragment
        android:id="@+id/eventoDetailFragment"
        android:name="com.example.eventos.home.eventos.EventoDetailFragment"
        android:label="Detalle del Evento"
        tools:layout="@layout/fragment_evento_detail">
        <argument
            android:name="evento"
            app:argType="com.example.eventos.core.model.Evento" />
    </fragment>
</navigation>
